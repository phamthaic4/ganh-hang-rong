{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": ".build",
    "rootDir": "../..",
    "types": []
  },
  "include": ["../../src/core/**/*.ts", "../../src/platform/**/*.ts", "src/**/*.ts"],
  "exclude": ["../../src/**/*.test.ts"]
}
